meta {
  name: Filtre
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/masterdb/search/filter
  body: none
  auth: none
}

docs {
  Valgene til filterpanelet ("More filters"): kommuner, lokaletyper,
  aktiviteter og fasiliteter. Kommuner er { kode (kommunenr), navn }; de tre
  andre er { id, navn }. Bare verdier som er koblet til en bookbar ressurs er
  med. Vis navn til brukeren, send kode/id som parameter til "Sok".
  Aktiviteter er flate (ingen forelder).
}

tests {
  test("svarer 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("har fire lister", function() {
    const b = res.getBody();
    expect(b.kommuner).to.be.an("array");
    expect(b.lokaletyper).to.be.an("array");
    expect(b.aktiviteter).to.be.an("array");
    expect(b.fasiliteter).to.be.an("array");
  });

  test("kommuner har kode og navn", function() {
    const kommuner = res.getBody().kommuner;
    if (kommuner.length > 0) {
      expect(kommuner[0].kode).to.be.a("string");
      expect(kommuner[0].navn).to.be.a("string");
    }
  });

  test("lokaletyper, aktiviteter og fasiliteter har id og navn", function() {
    const b = res.getBody();
    [b.lokaletyper, b.aktiviteter, b.fasiliteter].forEach(function(liste) {
      liste.forEach(function(v) {
        expect(v.id).to.be.a("number");
        expect(v.navn).to.be.a("string");
      });
    });
  });
}
