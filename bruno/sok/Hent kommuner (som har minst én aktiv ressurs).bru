meta {
  name: Hent kommuner (som har minst én aktiv ressurs)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/masterdb/search/filters/municipalities
  body: none
  auth: none
}

tests {
  test("svarer 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("er en liste", function() {
    expect(res.getBody()).to.be.an("array");
  });

  test("kommuner har kommunenr og navn", function() {
    const kommuner = res.getBody();
    if (kommuner.length > 0) {
      expect(kommuner[0].kommunenr).to.be.a("string");
      expect(kommuner[0].navn).to.be.a("string");
    }
  });
}

docs {
  Valgene til kommunefilteret: en flat liste av { kommunenr, navn }. Bare
  kommuner som er koblet til en bookbar ressurs er med. Vis navn til
  brukeren, send kommunenr som parameter "kommune" til "Sok".

  Lokaletyper, aktiviteter og fasiliteter hentes fra egne kall:
  /filters/resource-categories, /filters/activities og /filters/facilities.
}
