meta {
  name: Sok
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/masterdb/search
  body: none
  auth: none
}

params:query {
  q: bøneshallen
  ~kommune: 4601
  ~lokaletype: 1
  ~aktivitet: 1
  ~fasilitet: 1
  ~sorter: navn
  ~side: 0
  ~storrelse: 20
}

tests {
  test("svarer 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("har både bygg og ressurser", function() {
    const b = res.getBody();
    expect(b.bygg.treff).to.be.an("array");
    expect(b.ressurser.treff).to.be.an("array");
    expect(b.bygg.totalt).to.be.a("number");
    expect(b.ressurser.totalt).to.be.a("number");
  });
  
  test("bygg-treff har navn og lenke", function() {
    const bygg = res.getBody().bygg.treff;
    if (bygg.length > 0) {
      expect(bygg[0].byggNavn).to.be.a("string");
      expect(bygg[0].antallRessurser).to.be.above(0);
    }
  });
}

docs {
  Fritekstsøk + filtre. Returnerer både bygg (ett kort per bygg) og ressurser
  i ett svar. Parametrene med ~ foran er avslått; kryss dem av i Bruno for å
  bruke dem. Filtrene tar kommunenr og id-er, ikke navn (hent kode/id + navn fra "Filtre").
  Lister kan gjentas (?aktivitet=A&aktivitet=B) eller kommasepareres.
  
  Merk: aktivitet, lokaletype og fasilitet må finnes i databasen for å gi
  treff. q=ng treffer også midt i ord ("Ungdomshus", "Fyllingsdalen").
}
