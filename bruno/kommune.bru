meta {
  name: kommune
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/masterdb/kommune
  body: none
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

docs {
  Krever API-nokkel i headeren X-API-KEY. Nokkelen er det backend leser fra
  MASTERDB_API_KEY (.env). Sett verdien i miljoet "lokal" (variabelen apiKey
  er markert som secret, saa den lagres lokalt i Bruno og ikke i git).
  Riktig nokkel gir 200, og backend skriver "API key accepted" i konsollen.
}

tests {
  test("svarer 200 med riktig nokkel", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
