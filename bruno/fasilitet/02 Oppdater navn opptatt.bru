meta {
  name: 02 Oppdater navn opptatt
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/masterdb/fasilitet/:id
  body: json
  auth: none
}

params:path {
  id: 9002
}

headers {
  X-API-KEY: {{apiKey}}
}

body:json {
  {
    "navn": "Digital tavle",
    "parentId": 9001
  }
}

docs {
  Navnet er unikt. Digital tavle finnes fra før, så oppdateringen avvises.
}

tests {
  test("svarer 409", function() {
    expect(res.getStatus()).to.equal(409);
  });
}
