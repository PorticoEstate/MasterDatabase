meta {
  name: 05 Oppdater
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/masterdb/kommune/{{kommuneId}}
  body: json
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

body:json {
  {
    "kommunenr": "9998",
    "navn": "Testkommune endret",
    "fylkesnavn": "Annet fylke"
  }
}

docs {
  Endrer navn, fylkesnavn og kommunenr (9999 -> 9998). Uten bookingBaseUrl i body beholdes
  bookingsystemet som det er. Kjør 03 på nytt for å se endringen.
}

tests {
  test("svarer 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
