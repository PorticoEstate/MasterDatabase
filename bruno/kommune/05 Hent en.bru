meta {
  name: 05 Hent en
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/masterdb/kommune/{{kommuneId}}
  body: none
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

tests {
  test("svarer 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("riktig kommune", function() {
    expect(res.getBody().kommunenr).to.equal("9999");
  });
}

docs {
  Henter testkommunen paa id.
}
