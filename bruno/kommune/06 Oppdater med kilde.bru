meta {
  name: 06 Oppdater med kilde
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/masterdb/kommune/{{kommuneUtenKildeId}}
  body: json
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

body:json {
  {
    "kommunenr": "9997",
    "navn": "UtenKilde",
    "fylkesnavn": "Testfylke",
    "bookingBaseUrl": "https://utenkilde.aktiv-kommune.no"
  }
}

docs {
  Registrerer bookingsystemet på kommunen fra 02, slik at neste nattlige synk laster den.
  Kjør 04 Hent alle etterpå for å se bookingBaseUrl. Samme URL en gang til endrer ingenting.
  En annen URL enn den som er registrert, eller en URL som tilhører en annen kommune, gir 409.
  En oppdatering fjerner aldri bookingsystemet: utelater du bookingBaseUrl, beholdes det.
}

tests {
  test("svarer 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
