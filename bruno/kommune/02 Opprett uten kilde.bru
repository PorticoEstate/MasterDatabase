meta {
  name: 02 Opprett uten kilde
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/masterdb/kommune
  body: json
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

body:json {
  {
    "kommunenr": "9997",
    "navn": "UtenKilde",
    "fylkesnavn": "Testfylke"
  }
}

script:post-response {
  bru.setVar("kommuneUtenKildeId", res.getBody().id);
}

docs {
  Uten bookingBaseUrl opprettes kommunen, men den synkroniseres ikke. Id-en lagres i
  variabelen kommuneUtenKildeId. Kilden kan registreres senere, se 06 Oppdater med kilde.
}

tests {
  test("svarer 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("bookingBaseUrl er null", function() {
    expect(res.getBody().bookingBaseUrl).to.equal(null);
  });
}
