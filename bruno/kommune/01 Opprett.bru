meta {
  name: 01 Opprett
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/masterdb/kommune
  body: json
  auth: none
}

headers {
  X-API-KEY: {{apiKey}}
}

body:json {
  {
    "kommunenr": "9999",
    "navn": "Testkommune",
    "fylkesnavn": "Testfylke",
    "bookingBaseUrl": "https://testkommune.aktiv-kommune.no"
  }
}

script:post-response {
  bru.setVar("kommuneId", res.getBody().id);
}

docs {
  Oppretter testkommunen 9999 og registrerer bookingsystemet i samme kall. Id-en lagres i
  variabelen kommuneId, som de andre forespørslene bruker. Kjør 01-08 i rekkefølge; 07 og 08 rydder opp.
  Kalles den to ganger, gir det andre kallet 409. En bookingBaseUrl som ikke er
  https://<navn>.aktiv-kommune.no gir 400.
}

tests {
  test("svarer 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("returnerer kommunen med id og bookingBaseUrl", function() {
    const b = res.getBody();
    expect(b.id).to.be.a("number");
    expect(b.kommunenr).to.equal("9999");
    expect(b.bookingBaseUrl).to.equal("https://testkommune.aktiv-kommune.no");
  });
}
