meta {
  name: 03 Hent en
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/masterdb/kommune/:id
  body: none
  auth: none
}

params:path {
  id: 25
}

headers {
  X-API-KEY: {{apiKey}}
}

docs {
  Henter testkommunen på id.
}

tests {
  test("svarer 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("riktig kommune", function() {
    expect(res.getBody().kommunenr).to.equal("9999");
  });
}
