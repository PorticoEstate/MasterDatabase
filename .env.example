# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required. Password for the Postgres superuser; pick any strong value.
POSTGRES_PASSWORD=

# Matrikkel credentials (used for geocoding and building enrichment).
# Leave empty to skip that step; the rest of the pipeline still runs.
MATRIKKEL_BRUKER=
MATRIKKEL_PASSORD=

# Which Matrikkel environment to use:
#   test = prodtest.matrikkel.no (default if unset)
MATRIKKEL_MILJO=test

#APIkey for enpoints with security in spring backend
MASTERDB_API_KEY=

# OPTIONAL - avvikretention is set to 30 days default
# AVVIK_RETENTION_DAYS=30

# Optional. Host port for Postgres, bound to 127.0.0.1 only.
# DB_PORT=5432

# Optional. Only needed when building behind a corporate proxy.
# http_proxy=
# https_proxy=

# Optional ETL settings (defaults shown)
# KOMMUNER=alle
# SYNK_TID=03:00
# TZ=Europe/Oslo
# NORMALISER_DEMO=true
# DRY_RUN=false

