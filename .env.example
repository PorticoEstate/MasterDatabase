# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required. Password for the Postgres superuser; pick any strong value.
POSTGRES_PASSWORD=

# Optional. Host port for Postgres, bound to 127.0.0.1 only.
# DB_PORT=5432

# Optional. Only needed when building behind a corporate proxy.
# http_proxy=
# https_proxy=
